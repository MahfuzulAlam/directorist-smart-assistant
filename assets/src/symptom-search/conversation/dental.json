{
  "version": "1.0.0",
  "name": "dental_symptom_triage_flow",
  "description": "Adaptive question graph for dental symptom triage. Walk this graph in code; use the LLM for interpretation and phrasing, not for routing red flags.",
  "config": {
    "max_questions_per_session": 8,
    "max_questions_after_urgency_known": 2,
    "locale_default": "en",
    "locales_supported": ["en", "bn"],
    "stop_rule": "Emit assessment as soon as urgency tier is determinable. Precision of diagnosis is secondary to correct urgency tier."
  },

  "urgency_tiers": [
    { "id": "emergency",  "label": "Emergency",        "action": "Route to emergency care now. Do not offer normal booking.", "queue_score": 100 },
    { "id": "urgent_24h", "label": "Urgent (24h)",     "action": "Offer same-day or next-morning slot. Bypass normal queue.",  "queue_score": 80 },
    { "id": "soon_1week", "label": "Soon (within 1 week)", "action": "Offer earliest slot within 7 days.",                     "queue_score": 50 },
    { "id": "routine",    "label": "Routine",          "action": "Normal booking calendar.",                                   "queue_score": 20 }
  ],

  "red_flags": {
    "_comment": "LAYER 0. Evaluate in code BEFORE any LLM call. Any true value hard-routes to emergency regardless of model output. Present as one multi-select checklist, not sequential questions.",
    "node_id": "rf_gate",
    "type": "multi_select",
    "prompt": {
      "en": "Before we start — are any of these happening right now?",
      "bn": "শুরু করার আগে — এর মধ্যে কোনোটি কি এখন ঘটছে?"
    },
    "allow_none": true,
    "none_option": {
      "value": "none",
      "label": { "en": "None of these", "bn": "এর কোনোটিই নয়" },
      "next": "cc_chief_complaint"
    },
    "options": [
      { "value": "rf_airway",   "label": { "en": "Difficulty breathing or swallowing", "bn": "শ্বাস নিতে বা গিলতে কষ্ট" }, "urgency": "emergency", "reason": "Possible airway compromise from spreading infection." },
      { "value": "rf_spread",   "label": { "en": "Swelling spreading to eye, neck, or under the tongue", "bn": "চোখ, ঘাড় বা জিহ্বার নিচে ছড়ানো ফোলা" }, "urgency": "emergency", "reason": "Possible deep space infection (Ludwig's angina risk)." },
      { "value": "rf_fever",    "label": { "en": "Fever along with facial swelling", "bn": "মুখ ফোলার সাথে জ্বর" }, "urgency": "emergency", "reason": "Systemic involvement of dental infection." },
      { "value": "rf_bleed",    "label": { "en": "Bleeding that will not stop after 20 minutes of pressure", "bn": "২০ মিনিট চাপ দেওয়ার পরেও রক্তপাত বন্ধ হচ্ছে না" }, "urgency": "emergency", "reason": "Uncontrolled haemorrhage." },
      { "value": "rf_avulsion", "label": { "en": "A permanent tooth was knocked completely out", "bn": "স্থায়ী দাঁত সম্পূর্ণ খুলে পড়ে গেছে" }, "urgency": "emergency", "reason": "Avulsed tooth — replantation window is under 60 minutes." },
      { "value": "rf_jaw",      "label": { "en": "Jaw injury, or jaw will not close properly", "bn": "চোয়ালে আঘাত, বা চোয়াল ঠিকমতো বন্ধ হচ্ছে না" }, "urgency": "emergency", "reason": "Possible mandibular fracture or dislocation." }
    ],
    "on_any_true": {
      "halt_flow": true,
      "urgency": "emergency",
      "queue_score": 100,
      "show": "emergency_screen",
      "emit_immediate_guidance": true
    }
  },

  "nodes": {

    "cc_chief_complaint": {
      "layer": 1,
      "type": "single_select",
      "required": true,
      "summary_label": { "en": "Main problem", "bn": "মূল সমস্যা" },
      "prompt": {
        "en": "What's bothering you most right now?",
        "bn": "এই মুহূর্তে আপনাকে সবচেয়ে বেশি কষ্ট দিচ্ছে কোনটি?"
      },
      "options": [
        { "value": "pain",        "label": { "en": "Tooth or jaw pain", "bn": "দাঁত বা চোয়ালে ব্যথা" }, "next": "u_location" },
        { "value": "swelling",    "label": { "en": "Swelling", "bn": "ফোলা" }, "next": "u_location" },
        { "value": "gum_bleed",   "label": { "en": "Bleeding or sore gums", "bn": "মাড়ি থেকে রক্ত বা ব্যথা" }, "next": "u_location" },
        { "value": "broken",      "label": { "en": "Broken tooth, chip, or lost filling", "bn": "দাঁত ভাঙা, চিড় বা ফিলিং পড়ে গেছে" }, "next": "u_location" },
        { "value": "sensitivity", "label": { "en": "Sensitivity to hot / cold / sweet", "bn": "গরম / ঠান্ডা / মিষ্টিতে শিরশির" }, "next": "u_location" },
        { "value": "lesion",      "label": { "en": "Mouth sore, ulcer, patch, or bad breath", "bn": "মুখে ঘা, আলসার, দাগ বা দুর্গন্ধ" }, "next": "u_duration" },
        { "value": "appliance",   "label": { "en": "Problem with braces, denture, crown, or implant", "bn": "ব্রেসেস, নকল দাঁত, ক্রাউন বা ইমপ্লান্টে সমস্যা" }, "next": "u_location" },
        { "value": "routine",     "label": { "en": "Checkup, cleaning, or cosmetic", "bn": "চেকআপ, পরিষ্কার বা কসমেটিক" }, "next": "ctx_age", "set_urgency": "routine" }
      ]
    },

    "u_location": {
      "layer": 2,
      "type": "body_map",
      "required": true,
      "summary_label": { "en": "Where", "bn": "কোথায়" },
      "prompt": {
        "en": "Where is it? Tap the area — or pick below.",
        "bn": "কোথায় সমস্যা? জায়গাটি ট্যাপ করুন — অথবা নিচে থেকে বেছে নিন।"
      },
      "fallback_type": "single_select",
      "options": [
        { "value": "upper_right_back",  "label": { "en": "Upper right, back", "bn": "উপরে ডানে, পিছনে" } },
        { "value": "upper_right_front", "label": { "en": "Upper right, front", "bn": "উপরে ডানে, সামনে" } },
        { "value": "upper_left_front",  "label": { "en": "Upper left, front", "bn": "উপরে বামে, সামনে" } },
        { "value": "upper_left_back",   "label": { "en": "Upper left, back", "bn": "উপরে বামে, পিছনে" } },
        { "value": "lower_right_back",  "label": { "en": "Lower right, back", "bn": "নিচে ডানে, পিছনে" } },
        { "value": "lower_right_front", "label": { "en": "Lower right, front", "bn": "নিচে ডানে, সামনে" } },
        { "value": "lower_left_front",  "label": { "en": "Lower left, front", "bn": "নিচে বামে, সামনে" } },
        { "value": "lower_left_back",   "label": { "en": "Lower left, back", "bn": "নিচে বামে, পিছনে" } },
        { "value": "whole_mouth",       "label": { "en": "All over / can't tell", "bn": "পুরো মুখে / বলতে পারছি না" } },
        { "value": "jaw_joint",         "label": { "en": "Jaw joint (near the ear)", "bn": "চোয়ালের জয়েন্ট (কানের কাছে)" } }
      ],
      "next": "u_duration"
    },

    "u_duration": {
      "layer": 2,
      "type": "single_select",
      "required": true,
      "summary_label": { "en": "How long", "bn": "কতদিন ধরে" },
      "prompt": {
        "en": "How long has this been going on?",
        "bn": "কতদিন ধরে এই সমস্যা?"
      },
      "options": [
        { "value": "today",     "label": { "en": "Started today", "bn": "আজ শুরু হয়েছে" }, "score": 15 },
        { "value": "days",      "label": { "en": "A few days", "bn": "কয়েক দিন" }, "score": 10 },
        { "value": "weeks",     "label": { "en": "A few weeks", "bn": "কয়েক সপ্তাহ" }, "score": 5 },
        { "value": "months",    "label": { "en": "Months or longer", "bn": "কয়েক মাস বা তার বেশি" }, "score": 3, "flag": "chronic" }
      ],
      "next": "branch_router"
    },

    "branch_router": {
      "layer": 2,
      "type": "router",
      "_comment": "Not shown to user. Routes on the value of cc_chief_complaint.",
      "routes": {
        "pain":        "p_character",
        "swelling":    "s_pus",
        "gum_bleed":   "g_spontaneous",
        "broken":      "b_cause",
        "sensitivity": "p_trigger",
        "lesion":      "l_appearance",
        "appliance":   "a_type"
      },
      "default": "u_severity"
    },

    "u_severity": {
      "layer": 2,
      "type": "scale",
      "min": 1,
      "max": 10,
      "required": true,
      "summary_label": { "en": "Pain level", "bn": "ব্যথার মাত্রা" },
      "prompt": {
        "en": "How bad is it right now, from 1 (barely notice it) to 10 (worst pain imaginable)?",
        "bn": "এখন কতটা খারাপ, ১ (প্রায় বুঝতেই পারছি না) থেকে ১০ (কল্পনাতীত ব্যথা) পর্যন্ত?"
      },
      "scoring": [
        { "range": [1, 3],  "score": 5 },
        { "range": [4, 6],  "score": 20 },
        { "range": [7, 8],  "score": 40 },
        { "range": [9, 10], "score": 60, "min_urgency": "urgent_24h" }
      ],
      "next": "ctx_age"
    },

    "p_character": {
      "layer": 3,
      "branch": "pain",
      "type": "single_select",
      "summary_label": { "en": "Pain feels", "bn": "ব্যথার ধরন" },
      "prompt": {
        "en": "What does the pain feel like?",
        "bn": "ব্যথাটা কেমন অনুভব হয়?"
      },
      "options": [
        { "value": "sharp",     "label": { "en": "Sharp, shooting", "bn": "তীক্ষ্ণ, ঝিলিক দেওয়া" }, "score": 15 },
        { "value": "throbbing", "label": { "en": "Throbbing, pulsing", "bn": "দপদপ করা" }, "score": 30, "hint": "Throbbing suggests pulpal or periapical involvement." },
        { "value": "dull",      "label": { "en": "Dull, constant ache", "bn": "ভোঁতা, একটানা ব্যথা" }, "score": 15 },
        { "value": "pressure",  "label": { "en": "Pressure or fullness", "bn": "চাপ বা ভারী লাগা" }, "score": 20 }
      ],
      "next": "p_trigger"
    },

    "p_trigger": {
      "layer": 3,
      "branch": "pain",
      "type": "multi_select",
      "summary_label": { "en": "Set off by", "bn": "যাতে শুরু হয়" },
      "prompt": {
        "en": "What sets it off?",
        "bn": "কীসে ব্যথা শুরু হয়?"
      },
      "options": [
        { "value": "cold",    "label": { "en": "Cold food or drink", "bn": "ঠান্ডা খাবার বা পানীয়" }, "score": 10 },
        { "value": "hot",     "label": { "en": "Hot food or drink", "bn": "গরম খাবার বা পানীয়" }, "score": 25, "hint": "Heat-provoked pain is a strong irreversible-pulpitis signal." },
        { "value": "sweet",   "label": { "en": "Sweet things", "bn": "মিষ্টি জিনিস" }, "score": 10 },
        { "value": "biting",  "label": { "en": "Biting or chewing", "bn": "কামড়ালে বা চিবালে" }, "score": 25, "hint": "Pain on bite suggests cracked tooth or apical periodontitis." },
        { "value": "touch",   "label": { "en": "Touching it", "bn": "ছুঁলে" }, "score": 20 },
        { "value": "nothing", "label": { "en": "Nothing — it hurts on its own", "bn": "কিছুতেই না — নিজে নিজেই ব্যথা করে" }, "score": 40, "hint": "Spontaneous pain is a key irreversible-pulpitis marker.", "min_urgency": "urgent_24h" }
      ],
      "next": "p_lingering"
    },

    "p_lingering": {
      "layer": 3,
      "branch": "pain",
      "type": "single_select",
      "_comment": "HIGHEST-SIGNAL QUESTION. Lingering pain separates reversible sensitivity from irreversible pulpitis.",
      "summary_label": { "en": "Pain lasts", "bn": "ব্যথা থাকে" },
      "prompt": {
        "en": "After the trigger goes away, what happens to the pain?",
        "bn": "যেটাতে ব্যথা শুরু হয় সেটা সরে গেলে ব্যথার কী হয়?"
      },
      "options": [
        { "value": "stops_fast",  "label": { "en": "Stops within a few seconds", "bn": "কয়েক সেকেন্ডেই থেমে যায়" }, "score": 5,  "hint": "Suggests reversible pulpitis / dentine sensitivity." },
        { "value": "lingers",     "label": { "en": "Keeps hurting for a minute or more", "bn": "এক মিনিট বা তার বেশি ব্যথা থাকে" }, "score": 45, "hint": "Suggests irreversible pulpitis — likely needs endodontic care.", "min_urgency": "urgent_24h", "specialty": "endodontist" },
        { "value": "never_stops", "label": { "en": "It never really stops", "bn": "আসলে কখনো থামেই না" }, "score": 50, "min_urgency": "urgent_24h", "specialty": "endodontist" }
      ],
      "next": "p_night"
    },

    "p_night": {
      "layer": 3,
      "branch": "pain",
      "type": "single_select",
      "summary_label": { "en": "At night", "bn": "রাতে" },
      "prompt": {
        "en": "Does it wake you at night, or get worse when you lie down?",
        "bn": "রাতে কি ঘুম ভেঙে যায়, বা শুয়ে পড়লে বাড়ে?"
      },
      "options": [
        { "value": "yes",       "label": { "en": "Yes", "bn": "হ্যাঁ" }, "score": 35, "min_urgency": "urgent_24h", "hint": "Nocturnal / postural pain indicates pulpal inflammation." },
        { "value": "no",        "label": { "en": "No", "bn": "না" }, "score": 0 },
        { "value": "sometimes", "label": { "en": "Sometimes", "bn": "মাঝে মাঝে" }, "score": 15 }
      ],
      "next": "p_localised"
    },

    "p_localised": {
      "layer": 3,
      "branch": "pain",
      "type": "single_select",
      "summary_label": { "en": "Spread", "bn": "ছড়ানো" },
      "prompt": {
        "en": "Can you point to one exact tooth, or is it spread across an area?",
        "bn": "একটি নির্দিষ্ট দাঁত দেখাতে পারেন, নাকি পুরো একটা জায়গা জুড়ে?"
      },
      "options": [
        { "value": "one_tooth", "label": { "en": "One specific tooth", "bn": "একটি নির্দিষ্ট দাঁত" }, "score": 20, "hint": "Localised pain suggests periapical involvement — easier to identify." },
        { "value": "area",      "label": { "en": "A general area", "bn": "একটা সাধারণ জায়গা" }, "score": 10 },
        { "value": "radiating", "label": { "en": "It spreads to my ear, temple, or neck", "bn": "কান, কপাল বা ঘাড়ে ছড়িয়ে যায়" }, "score": 30, "hint": "Referred pain — check for TMD or spreading infection." }
      ],
      "next": "u_severity"
    },

    "s_pus": {
      "layer": 3,
      "branch": "swelling",
      "type": "single_select",
      "summary_label": { "en": "Pus or bump", "bn": "পুঁজ বা ফোসকা" },
      "prompt": {
        "en": "Is there any pus, a bad taste, or a small bump on the gum?",
        "bn": "পুঁজ, বাজে স্বাদ, বা মাড়িতে ছোট ফোসকা আছে কি?"
      },
      "options": [
        { "value": "pus",       "label": { "en": "Yes, pus or bad taste", "bn": "হ্যাঁ, পুঁজ বা বাজে স্বাদ" }, "score": 45, "min_urgency": "urgent_24h", "specialty": "oral_surgeon", "hint": "Draining abscess." },
        { "value": "bump",      "label": { "en": "A bump, but no pus", "bn": "ফোসকা আছে, পুঁজ নেই" }, "score": 35, "min_urgency": "urgent_24h" },
        { "value": "no",        "label": { "en": "No", "bn": "না" }, "score": 20 }
      ],
      "next": "s_progression"
    },

    "s_progression": {
      "layer": 3,
      "branch": "swelling",
      "type": "single_select",
      "summary_label": { "en": "Swelling", "bn": "ফোলা" },
      "prompt": {
        "en": "Is the swelling growing, staying the same, or going down?",
        "bn": "ফোলা কি বাড়ছে, একই আছে, নাকি কমছে?"
      },
      "options": [
        { "value": "growing", "label": { "en": "Growing", "bn": "বাড়ছে" }, "score": 45, "min_urgency": "urgent_24h" },
        { "value": "same",    "label": { "en": "About the same", "bn": "প্রায় একই" }, "score": 25 },
        { "value": "shrinking", "label": { "en": "Going down", "bn": "কমছে" }, "score": 10 }
      ],
      "next": "u_severity"
    },

    "g_spontaneous": {
      "layer": 3,
      "branch": "gum_bleed",
      "type": "single_select",
      "summary_label": { "en": "Bleeds when", "bn": "রক্ত পড়ে যখন" },
      "prompt": {
        "en": "When do the gums bleed?",
        "bn": "মাড়ি থেকে কখন রক্ত পড়ে?"
      },
      "options": [
        { "value": "brushing",    "label": { "en": "Only when brushing or flossing", "bn": "শুধু ব্রাশ বা ফ্লস করার সময়" }, "score": 10, "specialty": "general" },
        { "value": "eating",      "label": { "en": "When eating hard food", "bn": "শক্ত খাবার খাওয়ার সময়" }, "score": 15 },
        { "value": "spontaneous", "label": { "en": "On its own, without touching", "bn": "নিজে নিজেই, না ছুঁলেও" }, "score": 35, "min_urgency": "soon_1week", "specialty": "periodontist" }
      ],
      "next": "g_mobility"
    },

    "g_mobility": {
      "layer": 3,
      "branch": "gum_bleed",
      "type": "multi_select",
      "summary_label": { "en": "Also noticed", "bn": "সাথে আরও" },
      "prompt": {
        "en": "Any of these as well?",
        "bn": "এর সাথে এগুলোর কোনোটি আছে?"
      },
      "allow_none": true,
      "options": [
        { "value": "loose",     "label": { "en": "Teeth feel loose", "bn": "দাঁত নড়ছে মনে হয়" }, "score": 40, "min_urgency": "soon_1week", "specialty": "periodontist" },
        { "value": "receding",  "label": { "en": "Gums pulling back from teeth", "bn": "মাড়ি দাঁত থেকে সরে যাচ্ছে" }, "score": 25, "specialty": "periodontist" },
        { "value": "bad_smell", "label": { "en": "Persistent bad smell", "bn": "একটানা দুর্গন্ধ" }, "score": 20 },
        { "value": "gaps",      "label": { "en": "New gaps between teeth", "bn": "দাঁতের মাঝে নতুন ফাঁক" }, "score": 25 }
      ],
      "next": "u_severity"
    },

    "b_cause": {
      "layer": 3,
      "branch": "broken",
      "type": "single_select",
      "summary_label": { "en": "How it broke", "bn": "যেভাবে ভাঙল" },
      "prompt": {
        "en": "How did it break?",
        "bn": "কীভাবে ভাঙল?"
      },
      "options": [
        { "value": "trauma",   "label": { "en": "An injury or accident", "bn": "আঘাত বা দুর্ঘটনা" }, "score": 35, "min_urgency": "urgent_24h", "specialty": "oral_surgeon" },
