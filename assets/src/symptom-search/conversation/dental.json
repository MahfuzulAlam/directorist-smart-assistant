  "scoring": {
    "_comment": "queue_priority_score is the sum of triggered scores, clamped to 0-100, then floored by the highest min_urgency reached. The floor always wins over the sum.",
    "method": "sum_then_clamp",
    "clamp": [0, 100],
    "urgency_floor_overrides_sum": true,
    "thresholds": [
      { "min": 85, "urgency": "emergency" },
      { "min": 60, "urgency": "urgent_24h" },
      { "min": 30, "urgency": "soon_1week" },
      { "min": 0,  "urgency": "routine" }
    ]
  },

  "specialties": [
    { "id": "general",       "label": "General Dentist" },
    { "id": "endodontist",   "label": "Endodontist (root canal)" },
    { "id": "periodontist",  "label": "Periodontist (gums)" },
    { "id": "oral_surgeon",  "label": "Oral & Maxillofacial Surgeon" },
    { "id": "orthodontist",  "label": "Orthodontist (braces)" },
    { "id": "prosthodontist","label": "Prosthodontist (dentures, crowns)" },
    { "id": "pedodontist",   "label": "Pedodontist (children)" }
  ],

  "output_schema": {
    "probable_conditions": [{ "name": "string", "confidence": "high|medium|low" }],
    "urgency": "emergency|urgent_24h|soon_1week|routine",
    "urgency_reason": "string",
    "doctor_category": "string",
    "recommended_specialty": "string (id from specialties)",
    "queue_priority_score": "integer 0-100",
    "red_flags_triggered": ["string"],
    "self_care_until_visit": "string",
    "questions_still_needed": ["string"],
    "clinician_note": "string — concise summary for the dentist, not shown to patient",
    "disclaimer_shown": "boolean"
  },

  "safety_rules": [
    "Red flags are evaluated in code. Model output can raise urgency but can NEVER lower it below the code-determined floor.",
    "Never present a condition as confirmed. Always phrase as possible and always pair with the need for dentist confirmation.",
    "Never recommend a specific prescription medication, dose, or antibiotic.",
    "Never advise the patient to delay care to save money.",
    "If the model's confidence is low across all conditions, still emit an urgency tier — urgency drives the queue, diagnosis does not.",
    "If a user describes symptoms outside dentistry (chest pain, facial droop, severe headache with vision change), stop and direct to general emergency care.",
    "Log every session with the full answer set for clinical audit."
  ],

  "prompt_caching_note": "Everything in this file is static and belongs in the system prompt prefix, ahead of any conversation state. Approx 4,000+ tokens — comfortably clears OpenAI's 1,024-token cache floor and caches fully on Groq. Put only the answered-so-far state in the final user message."
}